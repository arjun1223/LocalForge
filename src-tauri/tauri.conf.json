{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalForge",
  "version": "0.1.0",
  "identifier": "dev.localforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalForge",
        "width": 1440,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 650,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/terrain-lines.icns", "icons/terrain-lines.png"],
    "category": "DeveloperTool",
    "shortDescription": "Private local AI and coding agent",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
